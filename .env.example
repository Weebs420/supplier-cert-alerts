# ─── Clerk ──────────────────────────────────────────────
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_WEBHOOK_SECRET=

# ─── Postgres (app role — subject to RLS) ───────────────
DATABASE_URL=postgresql://app_user:password@localhost:5432/supplier_certs

# Alert job role (BYPASSRLS) — REQUIRED for the alert cron to work
ALERT_DATABASE_URL=

# ─── R2 / Vercel Blob (certificate file storage) ───────
BLOB_READ_WRITE_TOKEN=

# ─── AI extraction ─────────────────────────────────────
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# ─── Email alerts ──────────────────────────────────────
RESEND_API_KEY=
ALERT_FROM_EMAIL=alerts@yourdomain.com

# ─── App ────────────────────────────────────────────────
APP_URL=http://localhost:3000
CRON_SECRET=change-me

# ─── Lemon Squeezy ──────────────────────────────────────
LEMON_SQUEEZY_API_KEY=
LEMON_SQUEEZY_STORE_ID=
LEMON_SQUEEZY_WEBHOOK_SECRET=
LEMON_PRODUCT_CORE=
LEMON_PRODUCT_FULL_SUITE=

# ─── Subscription enforcement ───────────────────────────
ENFORCE_FULL_SUITE=false
