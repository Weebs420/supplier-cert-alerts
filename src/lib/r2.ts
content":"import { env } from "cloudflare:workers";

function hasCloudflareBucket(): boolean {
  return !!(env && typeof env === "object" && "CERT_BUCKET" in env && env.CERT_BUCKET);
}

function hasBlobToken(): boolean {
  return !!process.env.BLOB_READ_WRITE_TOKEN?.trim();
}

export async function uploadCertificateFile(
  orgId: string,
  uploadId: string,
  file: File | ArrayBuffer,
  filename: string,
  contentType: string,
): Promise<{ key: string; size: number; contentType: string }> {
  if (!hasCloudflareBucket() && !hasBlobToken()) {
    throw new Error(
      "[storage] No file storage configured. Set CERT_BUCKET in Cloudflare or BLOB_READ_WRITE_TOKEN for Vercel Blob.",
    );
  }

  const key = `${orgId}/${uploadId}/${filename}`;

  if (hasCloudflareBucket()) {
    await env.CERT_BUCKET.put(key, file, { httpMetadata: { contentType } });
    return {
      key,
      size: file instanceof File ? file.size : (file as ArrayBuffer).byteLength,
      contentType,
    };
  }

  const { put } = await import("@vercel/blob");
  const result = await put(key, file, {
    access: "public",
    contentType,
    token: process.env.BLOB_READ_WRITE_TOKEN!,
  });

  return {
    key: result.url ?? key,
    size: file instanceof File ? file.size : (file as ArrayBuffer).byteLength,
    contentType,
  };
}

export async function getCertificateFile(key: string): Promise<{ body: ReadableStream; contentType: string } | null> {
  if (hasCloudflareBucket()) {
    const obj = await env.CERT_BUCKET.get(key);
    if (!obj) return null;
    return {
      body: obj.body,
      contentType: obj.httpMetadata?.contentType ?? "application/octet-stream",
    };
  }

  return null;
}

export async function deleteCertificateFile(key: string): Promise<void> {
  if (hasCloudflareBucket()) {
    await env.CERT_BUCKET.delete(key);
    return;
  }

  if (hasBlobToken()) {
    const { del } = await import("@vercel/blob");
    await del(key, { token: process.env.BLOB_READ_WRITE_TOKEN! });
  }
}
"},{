import process from "node:process";
import { Pool } from "pg";
import { Resend } from "resend";

const ALERT_DATABASE_URL = process.env.ALERT_DATABASE_URL?.trim();
const FALLBACK_DATABASE_URL = process.env.DATABASE_URL?.trim();

if (!ALERT_DATABASE_URL && !FALLBACK_DATABASE_URL) {
  throw new Error(
    "[alert-job] ALERT_DATABASE_URL is required for scheduled alerts. Configure a Postgres role with BYPASSRLS for the cron worker.",
  );
}

if (!ALERT_DATABASE_URL && FALLBACK_DATABASE_URL) {
  console.warn(
    "[alert-job] WARNING: ALERT_DATABASE_URL not set; falling back to DATABASE_URL. This is unsafe unless that role is configured with BYPASSRLS.",
  );
}

const pool = new Pool({
  connectionString: ALERT_DATABASE_URL || FALLBACK_DATABASE_URL,
  max: 3,
  statement_timeout: 15000,
  idle_in_transaction_session_timeout: 30000,
});

let _resend: Resend | null = null;

function getResend(): Resend {
  if (!_resend) {
    const key = process.env.RESEND_API_KEY?.trim();
    if (!key) throw new Error("[alert-job] RESEND_API_KEY not configured");
    _resend = new Resend(key);
  }

  return _resend;
}

function requireNonPlaceholder(name: string, value: string | undefined): string {
  if (!value || value.trim() === "") {
    throw new Error(`[alert-job] ${name} is required`);
  }

  const normalized = value.trim();
  const placeholders = new Set(["yourapp.com", "yourdomain.com", "change-me", "example.com"]);
  if (placeholders.has(normalized.replace(/^https?:\/\//, ""))) {
    throw new Error(`[alert-job] ${name} is still set to a placeholder value`);
  }

  return normalized;
}

const APP_URL = requireNonPlaceholder("APP_URL", process.env.APP_URL);
const ALERT_FROM = requireNonPlaceholder("ALERT_FROM_EMAIL", process.env.ALERT_FROM_EMAIL);

async function recomputeStatuses(): Promise<number> {
  const { rowCount } = await pool.query(`
    update certificates
    set status = case
      when expiry_date <= current_date then 'expired'
      when expiry_date <= current_date + interval '90 days' then 'expiring_soon'
      else 'valid'
    end
    where status is distinct from (
      case
        when expiry_date <= current_date then 'expired'
        when expiry_date <= current_date + interval '90 days' then 'expiring_soon'
        else 'valid'
      end
    );
  `);

  return rowCount ?? 0;
}

async function findDueAlerts() {
  const { rows } = await pool.query(`
    select
      c.id as certificate_id,
      c.certificate_type,
      c.expiry_date,
      s.name as supplier_name,
      u.email as recipient_email,
      ar.days_before_expiry
    from certificates c
    join suppliers s on s.id = c.supplier_id
    join users u on u.organization_id = c.organization_id and u.email is not null
    join alert_rules ar on ar.organization_id is null or ar.organization_id = c.organization_id
    where c.status in ('valid', 'expiring_soon')
      and ar.enabled = true
      and c.expiry_date <= current_date + (ar.days_before_expiry || ' days')::interval
      and c.expiry_date > current_date
      and not exists (
        select 1 from alerts_sent a
        where a.certificate_id = c.id
          and a.days_before_expiry = ar.days_before_expiry
      )
    order by c.expiry_date asc;
  `);

  return rows;
}

async function sendAlert(row: any): Promise<void> {
  const expiry = row.expiry_date instanceof Date
    ? row.expiry_date.toISOString().slice(0, 10)
    : String(row.expiry_date ?? "").slice(0, 10);

  const subject = `${row.supplier_name}'s ${row.certificate_type} expires in ${row.days_before_expiry} days`;
  const html = `
    <p><strong>Certificate alert</strong></p>
    <p>${row.supplier_name}'s ${row.certificate_type} certificate expires on <strong>${expiry}</strong>.</p>
    <p>Review the certificate now: <a href="${APP_URL}">${APP_URL}</a></p>
  `;

  await getResend().emails.send({
    from: ALERT_FROM,
    to: row.recipient_email,
    subject,
    html,
  });

  await pool.query(
    `insert into alerts_sent (certificate_id, days_before_expiry, recipient_email) values ($1, $2, $3)`,
    [row.certificate_id, row.days_before_expiry, row.recipient_email],
  );
}

export async function runAlertJob(): Promise<{
  refreshed: number;
  checked: number;
  sent: number;
  errors: string[];
  ok: boolean;
}> {
  const errors: string[] = [];
  let refreshed = 0;
  let sent = 0;
  let ok = true;

  try {
    refreshed = await recomputeStatuses();
  } catch (err) {
    const message = err instanceof Error ? err.message : "Unknown status refresh failure";
    errors.push(`Status refresh failed: ${message}`);
    ok = false;
  }

  let due: any[] = [];
  try {
    due = await findDueAlerts();
  } catch (err) {
    const message = err instanceof Error ? err.message : "Unknown alert query failure";
    errors.push(`Alert query failed: ${message}`);
    ok = false;
  }

  for (const row of due) {
    try {
      await sendAlert(row);
      sent += 1;
    } catch (err) {
      const message = err instanceof Error ? err.message : "Unknown send failure";
      errors.push(`Send failed for certificate ${row.certificate_id}: ${message}`);
      ok = false;
    }
  }

  return { refreshed, checked: due.length, sent, errors, ok };
}
